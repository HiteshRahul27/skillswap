# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000
# Local: mongodb://127.0.0.1:27017/skillswap  |  Atlas: mongodb+srv://USER:PASS@cluster.mongodb.net/skillswap
MONGO_URI=mongodb://127.0.0.1:27017/skillswap
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Credit rules
WELCOME_CREDITS=10
# Learners cannot cancel a confirmed session closer than this many hours to its start
CANCEL_CUTOFF_HOURS=12
# Set true only when MongoDB runs as a replica set (Atlas always does)
USE_TRANSACTIONS=false
# Cookie settings (production cross-site: COOKIE_SAMESITE=none and HTTPS required)
COOKIE_SAMESITE=lax
# Email for password reset (leave empty to use dev-only console links)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SkillSwap <no-reply@example.com>
# First admin (used only by `npm run create-admin`)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Dev seed password for demo users (seed refuses to run in production)
SEED_PASSWORD=Demo1234!
